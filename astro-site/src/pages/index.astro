---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const recipes = (await getCollection("recipes")).sort((a, b) => {
  const aTitle = a.data.title ?? a.id;
  const bTitle = b.data.title ?? b.id;
  return aTitle.localeCompare(bTitle, "sv");
});

const tags = [...new Set(recipes.flatMap((recipe) => recipe.data.tags))].sort((a, b) =>
  a.localeCompare(b, "sv"),
);

const getSearchText = (recipe: (typeof recipes)[number]) => {
  const ingredientText = [
    ...(recipe.data.ingredients ?? []).map((ingredient) => ingredient.name),
    ...(recipe.data.ingredientGroups ?? []).flatMap((group) =>
      [group.groupName, ...group.ingredients.map((ingredient) => ingredient.name)],
    ),
  ];

  const stepText = [
    ...(recipe.data.steps ?? []).flatMap((step) => [step.title, step.description]),
    ...(recipe.data.stepGroups ?? []).flatMap((group) => [
      group.groupName,
      ...group.steps.flatMap((step) => [step.title, step.description]),
    ]),
  ];

  return [
    recipe.data.title,
    recipe.data.description,
    ...recipe.data.tags,
    ...ingredientText,
    ...stepText,
    recipe.data.estimatedTime,
    recipe.data.rating,
    recipe.data.basePortions,
    recipe.id,
  ]
    .filter((value) => value != null && String(value).trim() !== "")
    .map(String)
    .join(" ")
    .toLocaleLowerCase("sv");
};

const getDietaryFilters = (recipe: (typeof recipes)[number]) => {
  const dietaryInfo = recipe.data.dietaryInfo;
  if (!dietaryInfo) return "";

  return [
    dietaryInfo.vegetarian && "vegetarian",
    dietaryInfo.vegan && "vegan",
    dietaryInfo.glutenFree && "glutenFree",
  ]
    .filter(Boolean)
    .join("|");
};
---

<BaseLayout title="Recept">
  <main class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <header class="mb-8 flex items-end justify-between gap-4 sm:mb-10">
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-primary">Kokboken</p>
        <h1 class="text-4xl font-bold tracking-tight text-base-content sm:text-5xl">Hitta något gott</h1>
        <p class="mt-3 text-base leading-7 text-base-content/65">
          Utforska {recipes.length} recept för vardag och helg.
        </p>
      </div>

      <a
        href="/rss.xml"
        class="btn btn-circle btn-ghost text-base-content/50 hover:bg-primary/10 hover:text-primary"
        title="Prenumerera via RSS"
        aria-label="Prenumerera via RSS"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75.75 0 0 1 1.5 0Z"
          />
        </svg>
      </a>
    </header>

    <form id="recipe-filters" class="card mb-8 border border-base-300 bg-base-100 p-4 shadow-sm sm:p-5">
      <label class="input input-lg w-full border-base-300 bg-base-200 shadow-none focus-within:border-primary focus-within:outline-none">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-5 w-5 text-base-content/50"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
          />
        </svg>
        <input
          id="site-search"
          type="search"
          class="grow"
          placeholder="Sök efter recept eller ingrediens"
          autocomplete="off"
          aria-label="Sök recept"
        />
      </label>

      <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <label class="form-control gap-1">
          <span class="text-xs font-semibold uppercase tracking-wide text-base-content/55">Tagg</span>
          <select id="tag-filter" class="select w-full border-base-300 bg-base-100" aria-label="Filtrera på tagg">
            <option value="">Alla taggar</option>
            {tags.map((tag) => <option value={tag}>{tag}</option>)}
          </select>
        </label>

        <label class="form-control gap-1">
          <span class="text-xs font-semibold uppercase tracking-wide text-base-content/55">Tid</span>
          <select id="time-filter" class="select w-full border-base-300 bg-base-100" aria-label="Filtrera på tid">
            <option value="">Alla tider</option>
            <option value="30">Högst 30 min</option>
            <option value="45">Högst 45 min</option>
            <option value="60">Högst 60 min</option>
            <option value="120">Högst 2 timmar</option>
          </select>
        </label>

        <label class="form-control gap-1">
          <span class="text-xs font-semibold uppercase tracking-wide text-base-content/55">Kost</span>
          <select id="dietary-filter" class="select w-full border-base-300 bg-base-100" aria-label="Filtrera på kost">
            <option value="">Alla kostval</option>
            <option value="vegetarian">Vegetariskt</option>
            <option value="vegan">Veganskt</option>
            <option value="glutenFree">Glutenfritt</option>
          </select>
        </label>

        <label class="form-control gap-1">
          <span class="text-xs font-semibold uppercase tracking-wide text-base-content/55">Sortera</span>
          <select id="sort-order" class="select w-full border-base-300 bg-base-100" aria-label="Sortera recept">
            <option value="title">Namn A–Ö</option>
            <option value="time">Kortast tid</option>
            <option value="rating">Högst betyg</option>
          </select>
        </label>
      </div>

      <div class="mt-4 flex min-h-8 items-center justify-between gap-4 border-t border-base-300 pt-3">
        <p id="result-count" class="text-sm text-base-content/60" aria-live="polite">
          Visar {recipes.length} recept
        </p>
        <button id="reset-filters" type="reset" class="btn btn-ghost btn-sm hidden text-base-content/65">
          Rensa filter
        </button>
      </div>
    </form>

    <div id="filter-empty" class="mb-8 hidden rounded-box border border-base-300 bg-base-100 p-6 text-center">
      <h2 class="text-lg font-semibold text-base-content">Inga recept matchar</h2>
      <p class="mt-1 text-sm text-base-content/60">Prova att ändra sökningen eller rensa något filter.</p>
    </div>

    <ul id="recipe-grid" class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        recipes.map((recipe) => (
          <li
            class="list-none"
            data-recipe-card
            data-title={(recipe.data.title ?? recipe.id).toLocaleLowerCase("sv")}
            data-search={getSearchText(recipe)}
            data-tags={recipe.data.tags.join("|")}
            data-time={recipe.data.estimatedTime}
            data-rating={recipe.data.rating ?? -1}
            data-dietary={getDietaryFilters(recipe)}
          >
            <a
              href={`/recipes/${recipe.id}`}
              class="group card h-full border border-base-300 bg-base-100 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-primary/60 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-base-200"
            >
              <div class="card-body gap-4 p-6">
                <div class="space-y-2">
                  <h2 class="text-xl font-semibold leading-snug tracking-tight text-base-content transition-colors group-hover:text-primary">
                    {recipe.data.title ?? recipe.id}
                  </h2>

                  {
                    recipe.data.description && (
                      <p class="line-clamp-3 text-sm leading-6 text-base-content/65">
                        {recipe.data.description}
                      </p>
                    )
                  }
                </div>

                <div class="flex flex-wrap gap-1.5">
                  {recipe.data.tags.map((tag) => (
                    <span class="badge badge-outline badge-sm text-base-content/60">{tag}</span>
                  ))}
                </div>

                <div class="mt-auto flex flex-wrap gap-2 text-sm text-base-content/65">
                  <span class="badge badge-soft px-3 py-3">
                    <span aria-hidden="true">⏱️</span>
                    {recipe.data.estimatedTime} min
                  </span>

                  {
                    recipe.data.rating != null && (
                      <span class="badge badge-soft badge-warning px-3 py-3">
                        <span aria-hidden="true">★</span>
                        {recipe.data.rating}/5
                      </span>
                    )
                  }
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>

  <script>
    const normalize = (value: string) => value.toLocaleLowerCase("sv").trim();

    const initializeFilters = () => {
      const form = document.querySelector<HTMLFormElement>("#recipe-filters");
      const searchInput = document.querySelector<HTMLInputElement>("#site-search");
      const tagFilter = document.querySelector<HTMLSelectElement>("#tag-filter");
      const timeFilter = document.querySelector<HTMLSelectElement>("#time-filter");
      const dietaryFilter = document.querySelector<HTMLSelectElement>("#dietary-filter");
      const sortOrder = document.querySelector<HTMLSelectElement>("#sort-order");
      const resetButton = document.querySelector<HTMLButtonElement>("#reset-filters");
      const resultCount = document.querySelector<HTMLElement>("#result-count");
      const emptyState = document.querySelector<HTMLElement>("#filter-empty");
      const recipeGrid = document.querySelector<HTMLUListElement>("#recipe-grid");

      if (
        !form ||
        !searchInput ||
        !tagFilter ||
        !timeFilter ||
        !dietaryFilter ||
        !sortOrder ||
        !resetButton ||
        !resultCount ||
        !emptyState ||
        !recipeGrid ||
        form.dataset.initialized
      ) {
        return;
      }

      form.dataset.initialized = "true";
      const cards = Array.from(recipeGrid.querySelectorAll<HTMLElement>("[data-recipe-card]"));

      const applyFilters = () => {
        const terms = normalize(searchInput.value).split(/\s+/).filter(Boolean);
        const selectedTag = tagFilter.value;
        const maxTime = timeFilter.value ? Number(timeFilter.value) : Number.POSITIVE_INFINITY;
        const selectedDietary = dietaryFilter.value;

        const sortedCards = [...cards].sort((a, b) => {
          if (sortOrder.value === "time") {
            return Number(a.dataset.time) - Number(b.dataset.time);
          }

          if (sortOrder.value === "rating") {
            const ratingDifference = Number(b.dataset.rating) - Number(a.dataset.rating);
            if (ratingDifference !== 0) return ratingDifference;
          }

          return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", "sv");
        });

        let visibleCount = 0;
        sortedCards.forEach((card) => {
          const searchText = card.dataset.search ?? "";
          const cardTags = (card.dataset.tags ?? "").split("|");
          const dietary = (card.dataset.dietary ?? "").split("|");
          const matches =
            terms.every((term) => searchText.includes(term)) &&
            (!selectedTag || cardTags.includes(selectedTag)) &&
            Number(card.dataset.time) <= maxTime &&
            (!selectedDietary || dietary.includes(selectedDietary));

          card.hidden = !matches;
          if (matches) visibleCount += 1;
          recipeGrid.append(card);
        });

        const hasActiveFilters = Boolean(
          searchInput.value || selectedTag || timeFilter.value || selectedDietary || sortOrder.value !== "title",
        );
        resultCount.textContent = `Visar ${visibleCount} av ${cards.length} recept`;
        resetButton.classList.toggle("hidden", !hasActiveFilters);
        emptyState.classList.toggle("hidden", visibleCount > 0);
        recipeGrid.classList.toggle("hidden", visibleCount === 0);
      };

      form.addEventListener("input", applyFilters);
      form.addEventListener("change", applyFilters);
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        applyFilters();
      });
      form.addEventListener("reset", () => window.setTimeout(applyFilters));
      applyFilters();
    };

    initializeFilters();
    document.addEventListener("astro:page-load", initializeFilters);
  </script>
</BaseLayout>
