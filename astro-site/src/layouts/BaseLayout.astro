---
import { ClientRouter } from "astro:transitions";
import "../assets/app.css";
const { title } = Astro.props;
---
<html lang="sv" class="bg-base-200" data-theme="cookbook" transition:name="root" transition:animate="slide">
  <head>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {
      import.meta.env.PROD && (
        <script defer src="https://umami.aghost.io/script.js" data-website-id="672e27d8-f1f3-4fb6-9d31-53bab92dc6ec"></script>
      )
    }
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-base-200 py-6 text-base-content antialiased sm:py-10">
    <article>
      <slot /> <!-- your content is injected here -->
    </article>
  </body>
</html>