---
import type { CollectionEntry } from "astro:content";

type Recipe = CollectionEntry<"recipes">;
type Step = NonNullable<Recipe["data"]["steps"]>[number];

interface Props {
  step: Step;
  stepId: string;
  recipeId: string;
  index: number;
}

const { step, stepId, recipeId, index } = Astro.props;
---

<div
  class="recipe-step group card cursor-pointer border border-base-300 bg-base-100 shadow-sm transition-all duration-200 hover:border-primary/60 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-base-200"
  data-recipe-id={recipeId}
  data-step-id={stepId}
  data-type="step"
  role="button"
  tabindex="0"
  aria-pressed="false"
>
  <div class="card-body gap-3 p-4 sm:p-5">
    <div class="flex items-start gap-3 sm:gap-4">
      <span class="badge badge-soft badge-primary h-8 w-8 shrink-0 rounded-full p-0 text-sm font-bold transition-colors group-hover:badge-primary">
        {index + 1}
      </span>
      <div class="min-w-0 flex-1">
        <h3 class="m-0 text-lg font-semibold leading-snug text-base-content">{step.title}</h3>
        <div class="mt-2 leading-7 text-base-content/65" set:html={step.description} />
      </div>
    </div>
  </div>
</div>
